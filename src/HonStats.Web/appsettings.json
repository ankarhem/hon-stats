{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HonStats": {
    "Persistence": {
      "ConnectionString": "Data Source=honstats.db"
    },
    "ReferenceData": {
      "RefreshIntervalHours": 12
    },
    "Indexing": {
      "ReindexCooldownMinutes": 15,
      "RecentMatchesLimit": 25,
      "MatchSummaryConcurrency": 4
    }
  }
}
