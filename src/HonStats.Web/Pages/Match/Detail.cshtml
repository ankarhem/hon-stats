@page "/match/{gameId:int}"
@model MatchDetailModel
@using HonStats.Web
@{
    var v = Model.View!;
    var d = v.Summary.Detail!;
    var loserTeam = d.WinningTeam == "Legion" ? "Hellbourne" : "Legion";
    ViewData["Title"] = $"Match #{d.GameId}";
}

<div class="detail-header match-header">
    <div class="match-header__result">
        <span class="team--@(d.WinningTeam.ToLowerInvariant())">@d.WinningTeam Victory</span>
        <span class="match-header__vs">vs</span>
        <span class="team--@(loserTeam.ToLowerInvariant())">@loserTeam</span>
    </div>
    <h1 class="match-header__title">Match #@d.GameId</h1>
    <div class="match-header__meta">
        <span>@ProfileModel.MapLabel(d.Map)</span>
        <span>@(d.Duration / 60)m @(d.Duration % 60)s</span>
        <span>@TimeDisplay.Relative(d.Date)</span>
    </div>
</div>

<div class="match-scoreboards">
    <partial name="Shared/Partials/_MatchSummaryTables" model="v.Summary" />
</div>

@if (v.HasReplay)
{
    <section class="panel card">
        <p class="eyebrow card__title">Net Worth Over Time</p>
        <partial name="Match/Partials/_NetWorthChart" model="v.Players" />
    </section>
    <section class="panel card">
        <p class="eyebrow card__title">Hero Damage Over Time</p>
        <partial name="Match/Partials/_DamageChart" model="v.Players" />
    </section>

    <section class="panel card">
        <p class="eyebrow card__title">Builds &amp; Skill Order</p>
        <div class="match-builds">
            @foreach (var team in v.Players.GroupBy(p => p.Team))
            {
                var teamLower = team.Key.ToLowerInvariant();
                <div class="match-builds__team">
                    <div class="match-builds__team-head match-builds__team-head--@teamLower">
                        <p class="match-builds__team-name team--@teamLower">@team.Key</p>
                        <span class="team-result @(team.Key == d.WinningTeam ? "team-result--win" : "team-result--loss")">
                            @(team.Key == d.WinningTeam ? "Victory" : "Defeat")
                        </span>
                    </div>
                    @foreach (var p in team.OrderBy(p => p.SlotIndex))
                    {
                        var hero = v.Summary.Heroes.GetValueOrDefault(p.HeroId);
                        var playerTeamLower = p.Team.ToLowerInvariant();
                        <details class="match-build">
                            <summary class="match-build__summary">
                                <span class="match-build__slot slot-bg--@playerTeamLower-@p.SlotIndex" aria-hidden="true"></span>
                                <span class="hero-icon-wrap">
                                    <img class="hero-icon" src="@hero?.IconUrl" alt="" loading="lazy" />
                                    @if (p.RoleIndex != 0 && d.Map != "MidWars")
                                    {
                                        <img class="hero-icon__role" src="/img/roles/role-@(ProfileModel.RoleSlug(p.RoleIndex)).png" alt="@ProfileModel.RoleLabel(p.RoleIndex)" title="@ProfileModel.RoleLabel(p.RoleIndex)" loading="lazy" />
                                    }
                                </span>
                                <span class="hero-name">@(hero?.TranslatedName ?? ("Hero " + p.HeroId))</span>
                                <span class="muted">@p.DisplayName</span>
                                <span class="match-build__chevron">▼</span>
                            </summary>
                            <div class="match-build__body">
                                <div>
                                    <p class="match-build__label">Item Build</p>
                                    <partial name="Match/Partials/_BuildTimeline" model="new BuildTimelineView(p, v.Summary.Items)" />
                                </div>
                                <div>
                                    <p class="match-build__label">Skill Order</p>
                                    <partial name="Match/Partials/_SkillBuild" model="new SkillBuildView(p, v.Abilities)" />
                                </div>
                            </div>
                        </details>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    <p class="muted">Replay timeline unavailable for this match.</p>
}
