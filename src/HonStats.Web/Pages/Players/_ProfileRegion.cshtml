@* /* noqa: SIZE_OK */ Intentionally single large HTMX fragment; splitting would break hx-swap boundaries. *@
@model ProfileModel
@using HonStats.Web
@using HonStats.App.Insights
<nav
    class="tabs"
    aria-label="Profile sections"
    hx-target="#profile-context"
    hx-select="#profile-context"
    hx-swap="innerHTML show:none"
>
    <a class="tab" href="?tab=matches&map=@Model.SelectedMap"
       aria-current="@(Model.Tab == "matches" ? "true" : null)">
        Matches
    </a>
    <a class="tab" href="?tab=teammates&map=@Model.SelectedMap"
       aria-current="@(Model.Tab == "teammates" ? "true" : null)">
        Teammates
    </a>
    <a class="tab" href="?tab=heroBuilds&map=@Model.SelectedMap"
       aria-current="@(Model.Tab == "heroBuilds" ? "true" : null)">
        Hero Builds
    </a>
</nav>

@switch (Model.Tab)
{
    case "teammates":
        @if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
        {
            <div class="empty-state">
                <p>Index this player to see who they usually play with.</p>
                <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
            </div>
        }
        else if (Model.Teammates.Count == 0)
        {
            <div class="empty-state"><p>No teammates indexed yet.</p></div>
        }
        else
        {
            <ul class="roster">
                    <partial name="Players/Partials/_TeammatesRows" model="new TeammatesView(Model.AccountId, Model.Teammates, 0, ProfileModel.PageSize, Model.HasMoreTeammates, Model.SelectedMap)" />
            </ul>
        }
        break;

    case "heroBuilds":
        @if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
        {
            <div class="empty-state">
                <p>Index this player to see what they buy on each hero.</p>
                <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
            </div>
        }
        else if (Model.HeroGames.Count == 0)
        {
            <div class="empty-state"><p>No hero data indexed yet.</p></div>
        }
        else
        {
            var heroGroups = Model.HeroGames
                .Select(kv => (HeroId: kv.Key, Games: kv.Value, Hero: Model.Heroes.GetValueOrDefault(kv.Key)))
                .Where(x => x.Hero is not null)
                .GroupBy(x => x.Hero!.PrimaryAttributeName)
                .OrderBy(g => g.Key)
                .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Hero!.DisplayName).ToList());

            <div class="hero-builds">
                <aside class="hero-builds__sidebar">
                    @foreach (var (attrName, heroes) in heroGroups)
                    {
                        <div class="hero-attribute-group">
                            <p class="eyebrow">@attrName</p>
                            <div class="hero-portraits">
                                @foreach (var h in heroes)
                                {
                                    var isActive = h.HeroId == Model.SelectedHeroId;
                                    <a class="hero-portrait" aria-current="@(isActive ? "true" : null)"
                                        href="?tab=heroBuilds&heroId=@h.HeroId&map=@Model.SelectedMap"
                                        hx-target="#profile-context"
                                        hx-select="#profile-context"
                                        hx-swap="innerHTML show:none"
                                        title="@h.Hero!.DisplayName (@h.Games)">
                                        <img src="@h.Hero!.IconUrl" alt="@h.Hero.DisplayName" loading="lazy" />
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </aside>
                <div class="hero-builds__main">

            @if (Model.HeroBuild.Count == 0)
            {
                <div class="empty-state"><p>No item data for this hero.</p></div>
            }
            else
            {
                var games = Model.HeroBuild.First().Games;
                var heroName = Model.Heroes.GetValueOrDefault(Model.SelectedHeroId)?.TranslatedName ?? ("Hero " + Model.SelectedHeroId);
                var timingByItem = Model.HeroItemTiming.ToDictionary(t => t.ItemId);
                var itemsById = Model.Items;

                var tierItems = Model.HeroBuild
                    .Select(b => (
                        ItemId: b.ItemId,
                        AvgSeconds: timingByItem.TryGetValue(b.ItemId, out var t) ? t.AvgSeconds : 0
                    ))
                    .ToList();
                var tierByItem = GuideTierClassifier.ClassifyByTime(
                    tierItems,
                    Model.EarlyCutoffMinutes,
                    Model.LateCutoffMinutes
                );
                var byTier = Model.HeroBuild
                    .GroupBy(e => tierByItem.GetValueOrDefault(e.ItemId))
                    .ToDictionary(
                        g => g.Key,
                        g => (IReadOnlyList<HeroBuildEntry>)g
                            .OrderBy(e => timingByItem.TryGetValue(e.ItemId, out var t) ? t.AvgSeconds : double.MaxValue)
                            .ThenBy(e => e.ItemId)
                            .ToList()
                    );

                <p class="eyebrow card__title">Items over @games games on @heroName</p>
                @foreach (var tier in new[] { GuideTier.Early, GuideTier.Core, GuideTier.Late })
                {
                    if (!byTier.TryGetValue(tier, out var tierEntries) || tierEntries.Count == 0)
                    {
                        continue;
                    }
                    var timeLabel = tier switch
                    {
                        GuideTier.Early => $"0\u2013{Model.EarlyCutoffMinutes} min",
                        GuideTier.Core => $"{Model.EarlyCutoffMinutes}\u2013{Model.LateCutoffMinutes} min",
                        GuideTier.Late => $"{Model.LateCutoffMinutes}+ min",
                        _ => ""
                    };
                    <section class="build-tier build-tier--@tier.ToString().ToLowerInvariant()">
                        <div class="build-tier__head">
                            <p class="eyebrow card__title">@tier</p>
                            <span class="build-tier__total">@timeLabel</span>
                        </div>
                        <div class="loadout-row__items">
                            @foreach (var (entry, itemIdx) in tierEntries.Select((e, i) => (e, i)))
                            {
                                var item = itemsById.GetValueOrDefault(entry.ItemId);
                                var iconUrl = item?.IconUrl ?? $"https://gamestorage.juvio.com/items/{entry.ItemId}/icon.webp";
                                var pickPct = games > 0 ? entry.Frequency * 100.0 / games : 0;
                                double? winPct = entry.Frequency > 0 ? entry.Wins * 100.0 / entry.Frequency : null;
                                var boughtAt = timingByItem.TryGetValue(entry.ItemId, out var timing)
                                    ? ProfileModel.FormatBuyTime(timing.AvgSeconds)
                                    : "—";
                                <span class="loadout-item item-tile">
                                    <img src="@iconUrl" alt="@(item?.DisplayName ?? "")" class="loadout-item__img" loading="lazy" />
                                    @if (item is not null)
                                    {
                                        <partial name="Shared/_ItemTooltip" model="new ItemTooltipView(item, iconUrl, new BuildStatsView(entry.Frequency, games, pickPct, winPct, boughtAt))" />
                                    }
                                </span>
                            }
                        </div>
                    </section>
                }

                @if (Model.Loadouts.Any())
                {
                    <section class="loadouts">
                        <p class="eyebrow card__title">Common Loadouts on @heroName</p>
                        <ul class="loadout-list">
                            @foreach (var (loadout, loadoutIndex) in Model.Loadouts.Select((l, i) => (l, i)))
                            {
                                <li class="loadout-row">
                                    <span class="loadout-row__items">
                                        @foreach (var (itemId, itemIndex) in loadout.ItemIds.Select((id, i) => (id, i)))
                                        {
                                            var item = itemsById.GetValueOrDefault(itemId);
                                            if (item is null) { continue; }
                                            <span class="loadout-item item-tile">
                                                <img src="@item.IconUrl" alt="@item.DisplayName" class="loadout-item__img" loading="lazy" />
                                                <partial name="Shared/_ItemTooltip" model="new ItemTooltipView(item, item.IconUrl)" />
                                            </span>
                                        }
                                    </span>
                                    <span class="loadout-row__stats">
                                        <span class="loadout-row__count">@loadout.Count×</span>
                                        <span class="loadout-row__winrate">@loadout.WinRate.ToString("0%")</span>
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }

            }
                </div>
            </div>
        }
        break;

    default:
        @if (Model.RecentMatches.Count == 0)
        {
            <div class="empty-state"><p>No matches found.</p></div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Hero</th><th>Result</th><th>K/D/A</th><th>Duration</th><th>Map</th><th>Date</th></tr>
                </thead>
                <tbody>
                    <partial name="Players/Partials/_MatchesRows" model="new MatchesView(Model.AccountId, Model.RecentMatches, Model.Heroes, 0, ProfileModel.PageSize, Model.HasMoreMatches, Model.SelectedMap)" />
                </tbody>
            </table>
        }
        break;
}
