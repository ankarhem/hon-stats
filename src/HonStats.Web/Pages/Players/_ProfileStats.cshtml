@model ProfileModel
@{
    var s = Model.MapOverview;
    var kdr = s is null ? (double?)null : s.AvgDeaths > 0 ? s.AvgKills / s.AvgDeaths : (double?)null;
    var r = Model.RosterStats;
}

<div class="panel card">
    <p class="eyebrow card__title">Profile stats</p>

    <div class="stat-grid">
        <div class="stat">
            <div class="eyebrow">K/D/A</div>
            <div class="stat__value">@(s is null ? "—" : $"{s.AvgKills:0.0} / {s.AvgDeaths:0.0} / {s.AvgAssists:0.0}")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Win rate</div>
            <div class="stat__value">@(s is null ? "—" : s.WinRate.ToString("0.00%"))</div>
            @if (s is not null)
            {
                <div class="stat__sub">@(s.Wins)W / @(s.Games - s.Wins)L over @s.Games games</div>
            }
        </div>
        <div class="stat">
            <div class="eyebrow">KDR</div>
            <div class="stat__value">@(kdr.HasValue ? kdr.Value.ToString("0.00") : "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg wards</div>
            <div class="stat__value">@(s is null ? "—" : s.AvgWards.ToString("0.0"))</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg GPM</div>
            <div class="stat__value">@(s?.AvgGPM?.ToString("0") ?? "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg XPM</div>
            <div class="stat__value">@(s?.AvgXPM?.ToString("0") ?? "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg DPM</div>
            <div class="stat__value">@(s?.AvgDPM?.ToString("0") ?? "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg CS</div>
            <div class="stat__value">@(r?.AvgCreepScore?.ToString("0.0") ?? "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg CS/min</div>
            <div class="stat__value">@(r?.AvgCsPerMinute?.ToString("0.00") ?? "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg denies</div>
            <div class="stat__value">@(r?.AvgDenies?.ToString("0.0") ?? "—")</div>
        </div>
        <div class="stat">
            <div class="eyebrow">Avg bldg dmg</div>
            <div class="stat__value">@(r?.AvgBuildingDamage?.ToString("0") ?? "—")</div>
        </div>
    </div>
</div>
