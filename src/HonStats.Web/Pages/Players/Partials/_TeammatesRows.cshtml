@model TeammatesView
@foreach (var t in Model.Teammates)
{
    var winPct = t.GamesTogether > 0 ? t.WinsTogether * 100 / t.GamesTogether : 0;
    <li class="roster__item" data-testid="teammate-row">
        <span class="flag">@ProfileModel.Flag(t.Country)</span>
        <a href="/players/@System.Uri.EscapeDataString(t.Username ?? t.TeammateAccountId.ToString())" class="roster__name">
            @(t.DisplayName ?? t.Username ?? t.TeammateAccountId.ToString())
        </a>
        <span class="muted">@t.GamesTogether games · @t.WinsTogether W (@winPct%)</span>
        <span class="roster__games">@t.GamesTogether</span>
    </li>
}
@if (Model.HasMore)
{
    var next = Model.Offset + Model.PageSize;
    <li class="roster__item loading-row"
        hx-get="?handler=TeammatesMore&accountId=@Model.AccountId&offset=@next&map=@Model.SelectedMap"
        hx-trigger="revealed" hx-target="this" hx-swap="outerHTML">
        <span class="muted">Loading more…</span>
    </li>
}
