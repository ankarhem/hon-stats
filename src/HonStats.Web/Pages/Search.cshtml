@page
@model SearchModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Search" : $"Search: {Model.Query}";
}

<section class="search-page">
    <h1>Player search</h1>
    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
        <p class="muted">Type a player name in the search box above to look up their stats.</p>
    }
    else
    {
        <p class="muted">@(Model.Results.Count == 0 ? $"No player named \"{Model.Query}\"." : "Closest matches:")</p>
        <partial name="_SearchResults" model="Model.Results" />
    }
</section>
