@model MatchDetailView
@if (Model.Detail is null)
{
    <p class="muted">Match not found.</p>
}
else
{
    var d = Model.Detail;
    var teamIndex = 0;
    <dialog class="modal" closedby="any" aria-label="Match details">
        <div class="modal__bar">
            <span class="modal__title">
                Match #@d.GameId · @d.Map · @(d.Duration / 60)m @(d.Duration % 60)s · @TimeDisplay.Relative(d.Date)
            </span>
            <form method="dialog"><button class="btn btn--ghost" type="submit">Close ✕</button></form>
        </div>
        <div class="modal__body">
            @foreach (var team in d.Players.GroupBy(p => p.Team))
            {
                var teamLower = team.Key.ToLowerInvariant();
                var ti = teamIndex++;
                <section class="match-section">
                    <p class="match-section__title team--@teamLower">
                        @team.Key @(team.Key == d.WinningTeam ? "· Winner" : "")
                    </p>
                    <table class="table match-table">
                        <thead>
                            <tr><th>Hero</th><th>K/D/A</th><th>Wards</th><th>Net</th><th>Items</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (pl, pi) in team.Select((p, i) => (p, i)))
                            {
                                var hero = Model.Heroes.GetValueOrDefault(pl.HeroId);
                                var name = Model.Names.GetValueOrDefault(pl.AccountId);
                                <tr>
                                    <td>
                                        <div class="match-row__hero">
                                            <img class="hero-icon" src="@hero?.IconUrl" alt="" loading="lazy" />
                                            <div>
                                                <span class="hero-name">@(hero?.TranslatedName ?? pl.HeroId.ToString())</span>
                                                <a class="match-row__player" href="/players/@System.Uri.EscapeDataString(name?.Username ?? pl.AccountId.ToString())">
                                                    <span class="flag">@ProfileModel.Flag(name?.Country)</span>@(name?.DisplayName ?? name?.Username ?? pl.AccountId.ToString())
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="kda">@pl.Kills/@pl.Deaths/@pl.Assists</td>
                                    <td class="muted">👁 @pl.WardOfSightPlaced / @pl.WardOfRevelationPlaced</td>
                                    <td class="muted">@pl.NetWorth</td>
                                    <td>
                                        <div class="item-row">
                                            @foreach (var (itemId, ii) in pl.Inventory.Select((id, i) => (id, i)))
                                            {
                                                var item = Model.Items.GetValueOrDefault(itemId);
                                                var iconUrl = item?.IconUrl ?? $"https://gamestorage.juvio.com/items/{itemId}/icon.webp";
                                                var anchorName = $"--m{ti}-p{pi}-i{ii}";
                                                <span class="loadout-item item-tile" style="anchor-name: @anchorName"
                                                      hx-on:pointerenter="this.querySelector('[popover]')?.showPopover()"
                                                      hx-on:pointerleave="this.querySelector('[popover]')?.hidePopover()">
                                                    <img class="loadout-item__img" src="@iconUrl" alt="@item?.DisplayName" loading="lazy" />
                                                    <div class="item-tooltip" popover="hint" role="tooltip"
                                                         style="position-anchor: @anchorName">
                                                        <div class="item-tooltip__head">
                                                            <img class="item-tooltip__head-icon" src="@iconUrl" alt="" loading="lazy" />
                                                            <div class="item-tooltip__head-text">
                                                                <span class="item-tooltip__name">@(item?.DisplayName ?? ("Item " + itemId))</span>
                                                                @if (item?.Tier is not null)
                                                                {
                                                                    <span class="item-tooltip__tier">@item.Tier</span>
                                                                }
                                                            </div>
                                                            @if (item is not null && item.TotalCost > 0)
                                                            {
                                                                <span class="item-tooltip__value gold">Value: @item.TotalCost.ToString("N0")</span>
                                                            }
                                                        </div>
                                                        <div class="item-tooltip__body">
                                                            @if (item is not null && !string.IsNullOrEmpty(item.Description))
                                                            {
                                                                <div class="item-tooltip__desc">@GameText.Render(item.Description)</div>
                                                            }
                                                            @if (item is not null && !string.IsNullOrEmpty(item.Description2))
                                                            {
                                                                <div class="item-tooltip__note">@GameText.Render(item.Description2)</div>
                                                            }
                                                            @if (item is not null && item.IsActive)
                                                            {
                                                                <div class="item-tooltip__section">
                                                                    <p class="eyebrow">Activation</p>
                                                                    <ul class="item-stat-list">
                                                                        @if (!string.IsNullOrEmpty(item.TargetType))
                                                                        {
                                                                            <li><span class="muted">Target</span> @item.TargetType</li>
                                                                        }
                                                                        @if (item.Range is > 0)
                                                                        {
                                                                            <li><span class="muted">Range</span> @item.Range</li>
                                                                        }
                                                                        @if (item.ManaCost is > 0)
                                                                        {
                                                                            <li><span class="muted">Mana cost</span> @item.ManaCost</li>
                                                                        }
                                                                        @if (item.Cooldown is > 0)
                                                                        {
                                                                            <li><span class="muted">Cooldown</span> <span class="highlight">@item.Cooldown s</span></li>
                                                                        }
                                                                    </ul>
                                                                    @if (!string.IsNullOrEmpty(item.ImpactEffect))
                                                                    {
                                                                        <div class="item-tooltip__prose">@GameText.Render(item.ImpactEffect)</div>
                                                                    }
                                                                </div>
                                                            }
                                                            @if (item is not null && (item.PassiveBonuses.Count > 0 || !string.IsNullOrEmpty(item.AttackImpactEffect)))
                                                            {
                                                                <div class="item-tooltip__section">
                                                                    @if (item.PassiveBonuses.Count > 0)
                                                                    {
                                                                        <p class="eyebrow">Passive Bonuses</p>
                                                                        <ul class="item-bonus-list">
                                                                            @foreach (var bonus in item.PassiveBonuses)
                                                                            {
                                                                                <li>@bonus</li>
                                                                            }
                                                                        </ul>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(item.AttackImpactEffect))
                                                                    {
                                                                        <p class="eyebrow">On Attack Impact</p>
                                                                        <div class="item-tooltip__prose">@GameText.Render(item.AttackImpactEffect)</div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        </div>
    </dialog>
}
