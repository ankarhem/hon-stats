@model ItemsModel
@using HonStats.Domain.ReferenceData
<ul class="grid-list">
    @foreach (var item in Model.Items)
    {
        <li class="grid-list__item item-tile @(Model.IsDimmed(item) ? "item-tile--dimmed" : null)">
            <a href="/items/@item.Slug">
                <img class="grid-list__icon" src="@item.IconUrl" alt="@item.DisplayName" loading="lazy" />
                <div class="grid-list__name">@item.DisplayName</div>
                @if (item.TotalCost > 0)
                {
                    <div class="grid-list__meta gold">@item.TotalCost</div>
                }
            </a>
            <div class="item-tooltip" role="tooltip">
                <div class="item-tooltip__head">
                    <img class="item-tooltip__head-icon" src="@item.IconUrl" alt="" loading="lazy" />
                    <div class="item-tooltip__head-text">
                        <span class="item-tooltip__name">@item.DisplayName</span>
                        @if (item.Tier is not null)
                        {
                            <span class="item-tooltip__tier">@item.Tier</span>
                        }
                    </div>
                    @if (item.TotalCost > 0)
                    {
                        <span class="item-tooltip__value gold">Value: @item.TotalCost</span>
                    }
                </div>
                <div class="item-tooltip__body">
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <div class="item-tooltip__desc">@GameText.Render(item.Description)</div>
                    }
                    @if (!string.IsNullOrEmpty(item.Description2))
                    {
                        <div class="item-tooltip__note">@GameText.Render(item.Description2)</div>
                    }
                    @if (item.IsActive)
                    {
                        <div class="item-tooltip__section">
                            <p class="eyebrow">Activation</p>
                            <ul class="item-stat-list">
                                @if (!string.IsNullOrEmpty(item.TargetType))
                                {
                                    <li><span class="muted">Target</span> @item.TargetType</li>
                                }
                                @if (item.Range is > 0)
                                {
                                    <li><span class="muted">Range</span> @item.Range</li>
                                }
                                @if (item.ManaCost is > 0)
                                {
                                    <li><span class="muted">Mana cost</span> @item.ManaCost</li>
                                }
                                @if (item.Cooldown is > 0)
                                {
                                    <li><span class="muted">Cooldown</span> <span class="highlight">@item.Cooldown s</span></li>
                                }
                            </ul>
                            @if (!string.IsNullOrEmpty(item.ImpactEffect))
                            {
                                <div class="item-tooltip__prose">@GameText.Render(item.ImpactEffect)</div>
                            }
                        </div>
                    }
                    @if (item.PassiveBonuses.Count > 0 || !string.IsNullOrEmpty(item.AttackImpactEffect))
                    {
                        <div class="item-tooltip__section">
                            @if (item.PassiveBonuses.Count > 0)
                            {
                                <p class="eyebrow">Passive Bonuses</p>
                                <ul class="item-bonus-list">
                                    @foreach (var bonus in item.PassiveBonuses)
                                    {
                                        <li>@bonus</li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrEmpty(item.AttackImpactEffect))
                            {
                                <p class="eyebrow">On Attack Impact</p>
                                <div class="item-tooltip__prose">@GameText.Render(item.AttackImpactEffect)</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </li>
    }
</ul>
