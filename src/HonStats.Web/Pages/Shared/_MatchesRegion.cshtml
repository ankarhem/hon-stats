@model MatchesView
<partial name="_ProfileTabs" model='new ProfileTabsView(Model.AccountId, "matches")' />

@if (Model.Matches.Count == 0)
{
    <div class="empty-state"><p>No matches found.</p></div>
}
else
{
    <table class="match-table">
        <thead>
            <tr><th>Hero</th><th>Result</th><th>K/D/A</th><th>Duration</th><th>Map</th><th>Date</th></tr>
        </thead>
        <tbody>
            <partial name="_MatchesRows" model="Model" />
        </tbody>
    </table>
}
