@model ProfileTabsView
@{
    var matches = Model.Active == "matches" ? "tab tab--active" : "tab";
    var teammates = Model.Active == "teammates" ? "tab tab--active" : "tab";
    var builds = Model.Active == "heroBuilds" ? "tab tab--active" : "tab";
}
<nav class="tabs" aria-label="Profile sections">
    <button class="@matches"
            hx-get="/Players/Profile/@Model.AccountId?handler=matches&offset=0"
            hx-target="#profile-region" hx-swap="innerHTML">
        Matches
    </button>
    <button class="@teammates"
            hx-get="/Players/Profile/@Model.AccountId?handler=teammates"
            hx-target="#profile-region" hx-swap="innerHTML">
        Teammates
    </button>
    <button class="@builds"
            hx-get="/Players/Profile/@Model.AccountId?handler=heroBuilds&heroId=0"
            hx-target="#profile-region" hx-swap="innerHTML">
        Hero Builds
    </button>
</nav>
