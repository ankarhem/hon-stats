@model ProfileModel
@{
    var maps = new[] { ("all", "All"), ("ForestsOfCaldavar", "Forests of Caldavar"), ("MidWars", "Mid Wars") };
    var heroParam = Model.SelectedHeroId > 0 ? $"&heroId={Model.SelectedHeroId}" : "";
}
<nav class="map-selector" aria-label="Map filter">
    @foreach (var (value, label) in maps)
    {
        var active = Model.SelectedMap == value;
        <a class="pill"
           href="?map=@value&tab=@Model.Tab@heroParam"
           hx-swap="innerHTML show:none"
           aria-current="@(active ? "true" : null)">
            @label
        </a>
    }
</nav>

<div id="profile-stats">
    <partial name="_ProfileStats" model="Model" />
</div>

<div id="profile-region">
    <partial name="_ProfileRegion" model="Model" />
</div>
