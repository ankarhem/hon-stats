@model ReindexButtonView
@{
    var indexing = Model.Indexed?.Status == IndexingStatus.Indexing;
    var rejected = Model.Result is { Outcome: ReindexOutcome.CooldownRejected };
}
<form method="post"
      hx-post="?handler=Reindex&accountId=@Model.AccountId"
      hx-target="this" hx-swap="outerHTML"
      hx-disabled-elt="button">
    @if (indexing)
    {
        <button class="btn" type="submit" disabled>Indexing…</button>
        <partial name="_IndexProgress" model="new IndexProgressView(Model.AccountId, 0, 0, false, null)" />
    }
    else
    {
        <button class="btn" type="submit">Reindex</button>
    }
    @if (Model.Result is not null)
    {
        if (rejected)
        {
            var mins = (int)Math.Ceiling(Model.Result.RetryAfter?.TotalMinutes ?? 0);
            <span class="reindex-status">On cooldown — try in @mins min</span>
        }
        else
        {
            <span class="reindex-status">Queued ✓</span>
        }
    }
    else if (Model.Indexed?.LastReindexAt is not null)
    {
        <span class="reindex-status">Last indexed @Model.Indexed.LastReindexAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
    }
    else
    {
        <span class="reindex-status">Not indexed yet</span>
    }
</form>
