@using HonStats.Web
@model MatchDetailView
@if (Model.Detail is null)
{
    <p class="muted">Match not found.</p>
}
else
{
    var d = Model.Detail;
    <dialog class="modal" closedby="any" aria-label="Match details">
        <div class="modal__bar">
            <span class="modal__title">
                Match #@d.GameId · @d.Map · @(d.Duration / 60)m @(d.Duration % 60)s · @TimeDisplay.Relative(d.Date)
            </span>
            <a class="btn btn--ghost" href="/match/@d.GameId">View full match →</a>
            <form method="dialog"><button class="btn btn--ghost" type="submit">Close ✕</button></form>
        </div>
        <div class="modal__body">
            <partial name="Shared/Partials/_MatchSummaryTables" model="Model" />
        </div>
    </dialog>
}
