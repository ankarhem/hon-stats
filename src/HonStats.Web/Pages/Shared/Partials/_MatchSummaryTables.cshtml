@using HonStats.Web
@model MatchDetailView
@{
    var d = Model.Detail!;
    var teamIndex = 0;
}
@foreach (var team in d.Players.GroupBy(p => p.Team).Select(g => g.OrderBy(p => Model.SlotsByAccount?.GetValueOrDefault(p.AccountId) ?? int.MaxValue)))
{
    var teamName = team.First().Team;
    var teamLower = teamName.ToLowerInvariant();
    var isWinner = teamName == d.WinningTeam;
    var ti = teamIndex++;
    <section class="match-section">
        <div class="match-section__head">
            <p class="match-section__title team--@teamLower">@teamName</p>
            <span class="team-result @(isWinner ? "team-result--win" : "team-result--loss")">
                @(isWinner ? "Victory" : "Defeat")
            </span>
        </div>
        <div class="match-section__panel match-section__panel--@teamLower">
            <table class="table match-table">
                <thead>
                    <tr><th>Hero</th><th>K/D/A</th><th>Wards</th><th>GPM</th><th>XPM</th><th>DPM</th><th>Items</th></tr>
                </thead>
                <tbody>
                @foreach (var (pl, pi) in team.Select((p, i) => (p, i)))
                {
                    var hero = Model.Heroes.GetValueOrDefault(pl.HeroId);
                    var name = Model.Names.GetValueOrDefault(pl.AccountId);
                    var slot = Model.SlotsByAccount?.GetValueOrDefault(pl.AccountId) ?? pi;
                    <tr class="match-row">
                        <td>
                            <div class="match-row__hero">
                                <span class="match-row__slot slot-bg--@teamLower-@slot" aria-hidden="true"></span>
                                    <span class="hero-icon-wrap">
                                        <img class="hero-icon" src="@hero?.IconUrl" alt="" loading="lazy" />
                                        @if (pl.RoleIndex != 0 && d.Map != "MidWars")
                                        {
                                            <img class="hero-icon__role" src="/img/roles/role-@(ProfileModel.RoleSlug(pl.RoleIndex)).png" alt="@ProfileModel.RoleLabel(pl.RoleIndex)" title="@ProfileModel.RoleLabel(pl.RoleIndex)" loading="lazy" />
                                        }
                                    </span>
                                    <div>
                                        <span class="hero-name">@(hero?.TranslatedName ?? pl.HeroId.ToString())</span>
                                        <a class="match-row__player" href="/players/@System.Uri.EscapeDataString(name?.Username ?? pl.AccountId.ToString())">
                                            <span class="flag">@ProfileModel.Flag(name?.Country)</span>@(name?.DisplayName ?? name?.Username ?? pl.AccountId.ToString())
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td class="kda">@pl.Kills/@pl.Deaths/@pl.Assists</td>
                            <td class="muted">👁 @pl.WardOfSightPlaced / @pl.WardOfRevelationPlaced</td>
                            <td class="muted">@ProfileModel.PerMinute(pl.NetWorth, d.Duration).ToString("0")</td>
                            <td class="muted">@ProfileModel.PerMinute(pl.Experience, d.Duration).ToString("0")</td>
                            <td class="muted">@ProfileModel.PerMinute(Model.HeroDamageByAccount.GetValueOrDefault(pl.AccountId), d.Duration).ToString("0")</td>
                            <td>
                                <div class="item-row">
                                    @foreach (var (itemId, ii) in pl.Inventory.Select((id, i) => (id, i)))
                                    {
                                        var item = Model.Items.GetValueOrDefault(itemId);
                                        var iconUrl = item?.IconUrl ?? $"https://gamestorage.juvio.com/items/{itemId}/icon.webp";
                                        <span class="loadout-item item-tile">
                                            <img class="loadout-item__img" src="@iconUrl" alt="@item?.DisplayName" loading="lazy" />
                                            @if (item is not null)
                                            {
                                                <partial name="Shared/_ItemTooltip" model="new ItemTooltipView(item, iconUrl)" />
                                            }
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
