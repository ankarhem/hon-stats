@model TeammatesView
<partial name="_ProfileTabs" model='new ProfileTabsView(Model.AccountId, "teammates")' />

@if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
{
    <div class="empty-state">
        <p>Index this player to see who they usually play with.</p>
        <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
    </div>
}
else if (Model.Teammates.Count == 0)
{
    <div class="empty-state"><p>No teammates indexed yet.</p></div>
}
else
{
    <ul class="roster">
        @foreach (var t in Model.Teammates)
        {
            var winPct = t.GamesTogether > 0 ? t.WinsTogether * 100 / t.GamesTogether : 0;
            <li class="roster__item">
                <span class="flag">@ProfileModel.Flag(t.Country)</span>
                <a href="/Players/Profile/@t.TeammateAccountId" class="roster__name">
                    @(t.DisplayName ?? t.Username ?? t.TeammateAccountId.ToString())
                </a>
                <span class="muted">@t.GamesTogether games · @t.WinsTogether W (@winPct%)</span>
                <span class="roster__games">@t.GamesTogether</span>
            </li>
        }
    </ul>
}
