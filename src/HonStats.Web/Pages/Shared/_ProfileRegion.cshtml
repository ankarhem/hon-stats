@model ProfileModel
@using HonStats.App.Insights
<nav class="tabs" aria-label="Profile sections">
    <button class="tab" aria-current="@(Model.Tab == "matches" ? "true" : null)"
            hx-get="?tab=matches&map=@Model.SelectedMap"
            hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
        Matches
    </button>
    <button class="tab" aria-current="@(Model.Tab == "teammates" ? "true" : null)"
            hx-get="?tab=teammates&map=@Model.SelectedMap"
            hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
        Teammates
    </button>
    <button class="tab" aria-current="@(Model.Tab == "heroBuilds" ? "true" : null)"
            hx-get="?tab=heroBuilds&map=@Model.SelectedMap"
            hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
        Hero Builds
    </button>
</nav>

@switch (Model.Tab)
{
    case "teammates":
        @if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
        {
            <div class="empty-state">
                <p>Index this player to see who they usually play with.</p>
                <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
            </div>
        }
        else if (Model.Teammates.Count == 0)
        {
            <div class="empty-state"><p>No teammates indexed yet.</p></div>
        }
        else
        {
            <ul class="roster">
                    <partial name="_TeammatesRows" model="new TeammatesView(Model.AccountId, Model.Teammates, 0, ProfileModel.PageSize, Model.HasMoreTeammates, Model.SelectedMap)" />
            </ul>
        }
        break;

    case "heroBuilds":
        @if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
        {
            <div class="empty-state">
                <p>Index this player to see what they buy on each hero.</p>
                <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
            </div>
        }
        else if (Model.HeroGames.Count == 0)
        {
            <div class="empty-state"><p>No hero data indexed yet.</p></div>
        }
        else
        {
            <div class="hero-picker">
                @foreach (var kv in Model.HeroGames.OrderByDescending(x => x.Value))
                {
                    var hero = Model.Heroes.GetValueOrDefault(kv.Key);
                    var isActive = kv.Key == Model.SelectedHeroId;
                    <a class="hero-picker__chip" aria-current="@(isActive ? "true" : null)"
                        hx-get="?tab=heroBuilds&heroId=@kv.Key&map=@Model.SelectedMap"
                        hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
                        @(hero?.TranslatedName ?? ("Hero " + kv.Key)) <span class="tab__count">(@kv.Value)</span>
                    </a>
                }
            </div>

            @if (Model.HeroBuild.Count == 0)
            {
                <div class="empty-state"><p>No item data for this hero.</p></div>
            }
            else
            {
                var games = Model.HeroBuild.First().Games;
                var heroName = Model.Heroes.GetValueOrDefault(Model.SelectedHeroId)?.TranslatedName ?? ("Hero " + Model.SelectedHeroId);
                var timingByItem = Model.HeroItemTiming.ToDictionary(t => t.ItemId);
                var itemsById = Model.Items;

                // Split the build into Early / Core / Late tiers by mean buy time.
                var tierItems = Model.HeroBuild
                    .Select(b => (
                        ItemId: b.ItemId,
                        AvgSeconds: timingByItem.TryGetValue(b.ItemId, out var t) ? t.AvgSeconds : 0
                    ))
                    .ToList();
                var tierByItem = GuideTierClassifier.ClassifyByTime(
                    tierItems,
                    Model.EarlyCutoffMinutes,
                    Model.LateCutoffMinutes
                );
                var byTier = Model.HeroBuild
                    .GroupBy(e => tierByItem.GetValueOrDefault(e.ItemId))
                    .ToDictionary(
                        g => g.Key,
                        g => (IReadOnlyList<HeroBuildEntry>)g
                            .OrderBy(e => timingByItem.TryGetValue(e.ItemId, out var t) ? t.AvgSeconds : double.MaxValue)
                            .ThenBy(e => e.ItemId)
                            .ToList()
                    );

                if (Model.Loadouts.Any())
                {
                    <section class="loadouts">
                        <p class="eyebrow card__title">Common Loadouts on @heroName</p>
                        <ul class="loadout-list">
                            @foreach (var (loadout, loadoutIndex) in Model.Loadouts.Select((l, i) => (l, i)))
                            {
                                <li class="loadout-row">
                                    <span class="loadout-row__items">
                                        @foreach (var (itemId, itemIndex) in loadout.ItemIds.Select((id, i) => (id, i)))
                                        {
                                            var item = itemsById.GetValueOrDefault(itemId);
                                            if (item is null)
                                            {
                                                continue;
                                            }
                                            var anchorName = $"--loadout{loadoutIndex}-item{itemIndex}";
                                            <span class="loadout-item item-tile" style="anchor-name: @anchorName">
                                                <img src="@item.IconUrl" alt="@item.DisplayName" class="loadout-item__img" loading="lazy" />
                                                <div class="item-tooltip" role="tooltip"
                                                     style="position-anchor: @anchorName; bottom: anchor(top); left: anchor(center); translate: -50% 0; position-try-fallbacks: flip-block">
                                                    <div class="item-tooltip__head">
                                                        <img class="item-tooltip__head-icon" src="@item.IconUrl" alt="" loading="lazy" />
                                                        <div class="item-tooltip__head-text">
                                                            <span class="item-tooltip__name">@item.DisplayName</span>
                                                            @if (item.Tier is not null)
                                                            {
                                                                <span class="item-tooltip__tier">@item.Tier</span>
                                                            }
                                                        </div>
                                                        @if (item.TotalCost > 0)
                                                        {
                                                            <span class="item-tooltip__value gold">Value: @item.TotalCost</span>
                                                        }
                                                    </div>
                                                    <div class="item-tooltip__body">
                                                        @if (!string.IsNullOrEmpty(item.Description))
                                                        {
                                                            <div class="item-tooltip__desc">@GameText.Render(item.Description)</div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.Description2))
                                                        {
                                                            <div class="item-tooltip__note">@GameText.Render(item.Description2)</div>
                                                        }
                                                        @if (item.IsActive)
                                                        {
                                                            <div class="item-tooltip__section">
                                                                <p class="eyebrow">Activation</p>
                                                                <ul class="item-stat-list">
                                                                    @if (!string.IsNullOrEmpty(item.TargetType))
                                                                    {
                                                                        <li><span class="muted">Target</span> @item.TargetType</li>
                                                                    }
                                                                    @if (item.Range is > 0)
                                                                    {
                                                                        <li><span class="muted">Range</span> @item.Range</li>
                                                                    }
                                                                    @if (item.ManaCost is > 0)
                                                                    {
                                                                        <li><span class="muted">Mana cost</span> @item.ManaCost</li>
                                                                    }
                                                                    @if (item.Cooldown is > 0)
                                                                    {
                                                                        <li><span class="muted">Cooldown</span> <span class="highlight">@item.Cooldown s</span></li>
                                                                    }
                                                                </ul>
                                                                @if (!string.IsNullOrEmpty(item.ImpactEffect))
                                                                {
                                                                    <div class="item-tooltip__prose">@GameText.Render(item.ImpactEffect)</div>
                                                                }
                                                            </div>
                                                        }
                                                        @if (item.PassiveBonuses.Count > 0 || !string.IsNullOrEmpty(item.AttackImpactEffect))
                                                        {
                                                            <div class="item-tooltip__section">
                                                                @if (item.PassiveBonuses.Count > 0)
                                                                {
                                                                    <p class="eyebrow">Passive Bonuses</p>
                                                                    <ul class="item-bonus-list">
                                                                        @foreach (var bonus in item.PassiveBonuses)
                                                                        {
                                                                            <li>@bonus</li>
                                                                        }
                                                                    </ul>
                                                                }
                                                                @if (!string.IsNullOrEmpty(item.AttackImpactEffect))
                                                                {
                                                                    <p class="eyebrow">On Attack Impact</p>
                                                                    <div class="item-tooltip__prose">@GameText.Render(item.AttackImpactEffect)</div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </span>
                                        }
                                    </span>
                                    <span class="loadout-row__stats">
                                        <span class="loadout-row__count">@loadout.Count×</span>
                                        <span class="loadout-row__winrate">@loadout.WinRate.ToString("0%")</span>
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }

                <p class="eyebrow card__title">Items over @games games on @heroName</p>
                @foreach (var tier in new[] { GuideTier.Early, GuideTier.Core, GuideTier.Late })
                {
                    if (!byTier.TryGetValue(tier, out var tierEntries) || tierEntries.Count == 0)
                    {
                        continue;
                    }
                    var costs = tierEntries.Select(e => itemsById.GetValueOrDefault(e.ItemId)?.TotalCost ?? 0).OrderBy(c => c).ToList();
                    var goldRange = costs.Count > 0 ? $"{costs[0]}g – {costs[^1]}g" : "";
                    <section class="build-tier build-tier--@tier.ToString().ToLowerInvariant()">
                        <div class="build-tier__head">
                            <p class="eyebrow card__title">@tier</p>
                            <span class="build-tier__total">@goldRange</span>
                        </div>
                        <div class="loadout-row__items">
                            @foreach (var (entry, itemIdx) in tierEntries.Select((e, i) => (e, i)))
                            {
                                var item = itemsById.GetValueOrDefault(entry.ItemId);
                                var iconUrl = item?.IconUrl ?? $"https://gamestorage.juvio.com/items/{entry.ItemId}/icon.webp";
                                var pickPct = games > 0 ? entry.Frequency * 100.0 / games : 0;
                                double? winPct = entry.Frequency > 0 ? entry.Wins * 100.0 / entry.Frequency : null;
                                var boughtAt = timingByItem.TryGetValue(entry.ItemId, out var timing)
                                    ? ProfileModel.FormatBuyTime(timing.AvgSeconds)
                                    : "—";
                                var anchorName = $"--{tier.ToString().ToLowerInvariant()}-{itemIdx}";
                                <span class="loadout-item item-tile" style="anchor-name: @anchorName">
                                    <img src="@iconUrl" alt="@(item?.DisplayName ?? "")" class="loadout-item__img" loading="lazy" />
                                    <div class="item-tooltip" role="tooltip"
                                         style="position-anchor: @anchorName; bottom: anchor(top); left: anchor(center); translate: -50% 0; position-try-fallbacks: flip-block">
                                        <div class="item-tooltip__head">
                                            <img class="item-tooltip__head-icon" src="@iconUrl" alt="" loading="lazy" />
                                            <div class="item-tooltip__head-text">
                                                <span class="item-tooltip__name">@(item?.DisplayName ?? ("Item " + entry.ItemId))</span>
                                                @if (item?.Tier is not null)
                                                {
                                                    <span class="item-tooltip__tier">@item.Tier</span>
                                                }
                                            </div>
                                            @if (item is not null && item.TotalCost > 0)
                                            {
                                                <span class="item-tooltip__value gold">Value: @item.TotalCost.ToString("N0")</span>
                                            }
                                        </div>
                                        <div class="item-tooltip__body">
                                            @if (item is not null && !string.IsNullOrEmpty(item.Description))
                                            {
                                                <div class="item-tooltip__desc">@GameText.Render(item.Description)</div>
                                            }
                                            @if (item is not null && !string.IsNullOrEmpty(item.Description2))
                                            {
                                                <div class="item-tooltip__note">@GameText.Render(item.Description2)</div>
                                            }
                                            @if (item is not null && item.IsActive)
                                            {
                                                <div class="item-tooltip__section">
                                                    <p class="eyebrow">Activation</p>
                                                    <ul class="item-stat-list">
                                                        @if (!string.IsNullOrEmpty(item.TargetType))
                                                        {
                                                            <li><span class="muted">Target</span> @item.TargetType</li>
                                                        }
                                                        @if (item.Range is > 0)
                                                        {
                                                            <li><span class="muted">Range</span> @item.Range</li>
                                                        }
                                                        @if (item.ManaCost is > 0)
                                                        {
                                                            <li><span class="muted">Mana cost</span> @item.ManaCost</li>
                                                        }
                                                        @if (item.Cooldown is > 0)
                                                        {
                                                            <li><span class="muted">Cooldown</span> <span class="highlight">@item.Cooldown s</span></li>
                                                        }
                                                    </ul>
                                                    @if (!string.IsNullOrEmpty(item.ImpactEffect))
                                                    {
                                                        <div class="item-tooltip__prose">@GameText.Render(item.ImpactEffect)</div>
                                                    }
                                                </div>
                                            }
                                            @if (item is not null && (item.PassiveBonuses.Count > 0 || !string.IsNullOrEmpty(item.AttackImpactEffect)))
                                            {
                                                <div class="item-tooltip__section">
                                                    @if (item.PassiveBonuses.Count > 0)
                                                    {
                                                        <p class="eyebrow">Passive Bonuses</p>
                                                        <ul class="item-bonus-list">
                                                            @foreach (var bonus in item.PassiveBonuses)
                                                            {
                                                                <li>@bonus</li>
                                                            }
                                                        </ul>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.AttackImpactEffect))
                                                    {
                                                        <p class="eyebrow">On Attack Impact</p>
                                                        <div class="item-tooltip__prose">@GameText.Render(item.AttackImpactEffect)</div>
                                                    }
                                                </div>
                                            }
                                            <div class="item-tooltip__section">
                                                <p class="eyebrow">Build Stats</p>
                                                <ul class="item-stat-list">
                                                    <li><span class="muted">Bought</span> @entry.Frequency/@games (@pickPct.ToString("0.00")%)</li>
                                                    <li><span class="muted">Win Rate</span> @(winPct.HasValue ? winPct.Value.ToString("0.00") + "%" : "—")</li>
                                                    <li><span class="muted">MBT</span> @boughtAt</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </span>
                            }
                        </div>
                    </section>
                }

            }
        }
        break;

    default:
        @if (Model.RecentMatches.Count == 0)
        {
            <div class="empty-state"><p>No matches found.</p></div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Hero</th><th>Result</th><th>K/D/A</th><th>Duration</th><th>Map</th><th>Date</th></tr>
                </thead>
                <tbody>
                    <partial name="_MatchesRows" model="new MatchesView(Model.AccountId, Model.RecentMatches, Model.Heroes, 0, ProfileModel.PageSize, Model.HasMoreMatches, Model.SelectedMap)" />
                </tbody>
            </table>
        }
        break;
}
