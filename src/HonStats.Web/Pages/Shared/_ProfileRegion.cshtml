@model ProfileModel
<nav class="tabs" aria-label="Profile sections">
    <button class="tab" aria-current="@(Model.Tab == "matches" ? "true" : null)"
            hx-get="@Url.Page("/Players/Profile", null, new { accountId = Model.AccountId, tab = "matches" })"
            hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
        Matches
    </button>
    <button class="tab" aria-current="@(Model.Tab == "teammates" ? "true" : null)"
            hx-get="@Url.Page("/Players/Profile", null, new { accountId = Model.AccountId, tab = "teammates" })"
            hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
        Teammates
    </button>
    <button class="tab" aria-current="@(Model.Tab == "heroBuilds" ? "true" : null)"
            hx-get="@Url.Page("/Players/Profile", null, new { accountId = Model.AccountId, tab = "heroBuilds" })"
            hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
        Hero Builds
    </button>
</nav>

@switch (Model.Tab)
{
    case "teammates":
        @if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
        {
            <div class="empty-state">
                <p>Index this player to see who they usually play with.</p>
                <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
            </div>
        }
        else if (Model.Teammates.Count == 0)
        {
            <div class="empty-state"><p>No teammates indexed yet.</p></div>
        }
        else
        {
            <ul class="roster">
                <partial name="_TeammatesRows" model="new TeammatesView(Model.AccountId, Model.Teammates, 0, ProfileModel.PageSize, Model.HasMoreTeammates)" />
            </ul>
        }
        break;

    case "heroBuilds":
        @if (Model.Indexed is null || Model.Indexed.Status != IndexingStatus.Indexed)
        {
            <div class="empty-state">
                <p>Index this player to see what they buy on each hero.</p>
                <p class="empty-state__action">↑ Hit the Reindex button (top right).</p>
            </div>
        }
        else if (Model.HeroGames.Count == 0)
        {
            <div class="empty-state"><p>No hero data indexed yet.</p></div>
        }
        else
        {
            <div class="hero-picker">
                @foreach (var kv in Model.HeroGames.OrderByDescending(x => x.Value))
                {
                    var hero = Model.Heroes.GetValueOrDefault(kv.Key);
                    var isActive = kv.Key == Model.SelectedHeroId;
                    <a class="hero-picker__chip" aria-current="@(isActive ? "true" : null)"
                       hx-get="@Url.Page("/Players/Profile", null, new { accountId = Model.AccountId, tab = "heroBuilds", heroId = kv.Key })"
                       hx-target="#profile-region" hx-swap="innerHTML" hx-push-url="true">
                        @(hero?.TranslatedName ?? ("Hero " + kv.Key)) <span class="tab__count">(@kv.Value)</span>
                    </a>
                }
            </div>

            @if (Model.HeroBuild.Count == 0)
            {
                <div class="empty-state"><p>No item data for this hero.</p></div>
            }
            else
            {
                var games = Model.HeroBuild.First().Games;
                var heroName = Model.Heroes.GetValueOrDefault(Model.SelectedHeroId)?.TranslatedName ?? ("Hero " + Model.SelectedHeroId);
                <p class="eyebrow card__title">Items over @games games on @heroName</p>
                <ul class="grid-list">
                    @foreach (var entry in Model.HeroBuild)
                    {
                        var item = Model.Items.GetValueOrDefault(entry.ItemId);
                        var iconUrl = item?.IconUrl ?? $"https://gamestorage.juvio.com/items/{entry.ItemId}/icon.webp";
                        var pickPct = games > 0 ? entry.Frequency * 100 / games : 0;
                        <li class="grid-list__item">
                            <img class="grid-list__icon" src="@iconUrl" alt="" loading="lazy" />
                            <div class="grid-list__name">@(item?.TranslatedName ?? ("Item " + entry.ItemId))</div>
                            <div class="grid-list__meta">@entry.Frequency/@games · @pickPct%</div>
                        </li>
                    }
                </ul>
            }
        }
        break;

    default:
        @if (Model.RecentMatches.Count == 0)
        {
            <div class="empty-state"><p>No matches found.</p></div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Hero</th><th>Result</th><th>K/D/A</th><th>Duration</th><th>Map</th><th>Date</th></tr>
                </thead>
                <tbody>
                    <partial name="_MatchesRows" model="new MatchesView(Model.AccountId, Model.RecentMatches, Model.Heroes, 0, ProfileModel.PageSize, Model.HasMoreMatches)" />
                </tbody>
            </table>
        }
        break;
}
