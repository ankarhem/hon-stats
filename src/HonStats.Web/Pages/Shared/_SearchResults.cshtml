@model IReadOnlyList<PlayerNameSearchResult>

@if (Model.Count == 0)
{
    <p class="panel search-results__empty">No players found.</p>
}
else
{
    <ul class="panel search-results__list">
        @foreach (var player in Model)
        {
            var showDisplay =
                !string.IsNullOrEmpty(player.DisplayName)
                && !string.Equals(
                    player.DisplayName,
                    player.Username,
                    StringComparison.OrdinalIgnoreCase
                );
            <li class="search-results__item" role="option">
                <a href="/players/@System.Uri.EscapeDataString(player.Username)">
                    @if (showDisplay)
                    {
                        <span class="search-results__display">@player.DisplayName</span>
                        <span class="search-results__handle">@player.Username</span>
                    }
                    else
                    {
                        @player.Username
                    }
                </a>
            </li>
        }
    </ul>
}
