@page "/items"
@model ItemsModel
@{
    ViewData["Title"] = "Items";
}

<h1>Items</h1>

<form class="hero-filter"
      hx-get="/items"
      hx-target="#item-grid"
      hx-swap="innerHTML"
      hx-trigger="input changed delay:80ms">
    <input class="search__input hero-filter__search"
           type="search"
           name="q"
           value="@Model.Query"
           placeholder="Search item name…"
           autocomplete="off"
           aria-label="Item name" />
</form>

<div id="item-grid">
    <partial name="_ItemGrid" model="Model" />
</div>
