@page "/items"
@model ItemsModel
@{
    ViewData["Title"] = "Items";
}

<h1>Items</h1>

<form class="filter-bar"
      hx-get="/items"
      hx-target="#item-grid"
      hx-trigger="input changed delay:80ms"
      hx-include="#active-cat">
    <input id="item-search"
           class="search__input filter-bar__search"
           type="search"
           name="q"
           value="@Model.Query"
           placeholder="Search item name…"
           autocomplete="off"
           aria-label="Item name" />
</form>

<div id="item-region">
    <partial name="Shared/Partials/_ItemRegion" model="Model" />
</div>
