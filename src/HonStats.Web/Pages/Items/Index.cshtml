@page "/items"
@model ItemsModel
@{
    ViewData["Title"] = "Items";
}

<h1>Items</h1>
<ul class="grid-list">
    @foreach (var item in Model.Items)
    {
        <li class="grid-list__item">
            <a href="/items/@item.Slug">
                <img class="grid-list__icon" src="@item.IconUrl" alt="" loading="lazy" />
                <div class="grid-list__name">@item.TranslatedName</div>
                @if (item.Cost > 0)
                {
                    <div class="grid-list__meta">@item.Cost gold</div>
                }
            </a>
        </li>
    }
</ul>
