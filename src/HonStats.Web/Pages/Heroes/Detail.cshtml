@page "/heroes/{slug}"
@model HeroDetailModel
@{
    ViewData["Title"] = Model.Hero?.TranslatedName ?? "Hero";
}

@if (Model.Hero is null)
{
    <div class="empty-state">
        <h2>Hero not found</h2>
        <p><a href="/heroes">← Back to heroes</a></p>
    </div>
}
else
{
    var h = Model.Hero;
    <div class="detail-header">
        <img class="detail-header__icon" src="@h.IconUrl" alt="" loading="lazy" />
        <div>
            <h1 class="detail-header__name">@h.TranslatedName</h1>
            <p class="detail-header__meta">@h.PrimaryAttributeName · <span class="capitalize">@(h.AttackType ?? "")</span></p>
        </div>
    </div>

    <div class="panel card">
        <ul class="combat-stats">
            <li><span class="muted">Damage</span><strong>@h.DisplayDamageMin–@h.DisplayDamageMax</strong></li>
            <li><span class="muted">Atk Range</span><strong>@h.AttackRange</strong></li>
            <li><span class="muted">Atk Speed</span><strong>@h.AttackSpeed.ToString("0.00")</strong></li>
            <li><span class="muted">Move Speed</span><strong>@h.MoveSpeed</strong></li>
        </ul>
        <div class="attr-boxes">
            <div class="attr-box @(h.PrimaryAttribute == 0 ? "attr-box--primary" : null)">
                <span class="muted">STR</span><strong>@h.Strength</strong>
            </div>
            <div class="attr-box @(h.PrimaryAttribute == 1 ? "attr-box--primary" : null)">
                <span class="muted">AGI</span><strong>@h.Agility</strong>
            </div>
            <div class="attr-box @(h.PrimaryAttribute == 2 ? "attr-box--primary" : null)">
                <span class="muted">INT</span><strong>@h.Intelligence</strong>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(h.RoleDescription))
    {
        <div class="panel card">
            <p class="eyebrow card__title">Hero Role</p>
            <p>@h.RoleDescription</p>
        </div>
    }

    @if (h.Abilities.Count > 0)
    {
        <div class="ability-cards">
            @foreach (var a in h.Abilities)
            {
                <article class="panel ability-card">
                    <header class="ability-card__head">
                        <img class="ability-icon" src="@a.IconUrl" alt="" loading="lazy" />
                        <div>
                            <h3 class="ability-card__name">@a.TranslatedName</h3>
                            @if (a.ManaCost.Any(m => m > 0))
                            {
                                <div class="ability-card__mana">Mana: @string.Join("/", a.ManaCost)</div>
                            }
                        </div>
                    </header>
                    @if (!string.IsNullOrEmpty(a.Description))
                    {
                        <div class="ability-card__desc">@GameText.Render(a.Description)</div>
                    }
                    <footer class="ability-card__foot">
                        @if (a.Range > 0)
                        {
                            <span>Range: @a.Range</span>
                        }
                        @if (a.Cooldown.Any(c => c > 0))
                        {
                            <span>CD: @string.Join("/", a.Cooldown)s</span>
                        }
                    </footer>
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(h.Description))
    {
        <div class="panel card">
            <p class="eyebrow card__title">Lore</p>
            <p class="muted">@h.Description</p>
        </div>
    }
}
