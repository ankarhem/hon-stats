@page "/heroes"
@model HeroesModel
@{
    ViewData["Title"] = "Heroes";
}

<h1>Heroes</h1>

<form class="filter-bar"
      hx-get="/heroes"
      hx-target="#hero-grid"
      hx-swap="innerHTML"
      hx-trigger="input changed delay:80ms, change">
    <input class="search__input filter-bar__search"
           type="search"
           name="q"
           value="@Model.Query"
           placeholder="Search hero name…"
           autocomplete="off"
           aria-label="Hero name" />
    <div class="filter-bar__group" role="group" aria-label="Filter by role">
        @foreach (var (role, label) in HeroesModel.Roles)
        {
            <label class="filter-toggle">
                <input type="checkbox" name="roles" value="@role"
                       checked="@(Model.ActiveRoles.Contains(role))" />
                <span>@label</span>
            </label>
        }
    </div>
</form>

<div id="hero-grid">
    <partial name="Shared/Partials/_HeroGrid" model="Model" />
</div>
